{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx lint-staged *)",
      "Bash(node scripts/*)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git commit --amend *)",
      "Bash(git commit * --amend *)",
      "Bash(git commit * --amend)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify *)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git commit -an*)",
      "Bash(git commit * -an*)",
      "Bash(git commit -sn*)",
      "Bash(git commit * -sn*)",
      "Bash(git commit -qn*)",
      "Bash(git commit * -qn*)",
      "Bash(git commit -vn*)",
      "Bash(git commit * -vn*)",
      "Bash(git add -f*)",
      "Bash(git add * -f*)",
      "Bash(git add --force*)",
      "Bash(git add * --force*)",
      "Bash(git add -Af*)",
      "Bash(git add * -Af*)",
      "Bash(git add -uf*)",
      "Bash(git add * -uf*)",
      "Bash(git add -vf*)",
      "Bash(git add * -vf*)",
      "Bash(git tag -f*)",
      "Bash(git tag * -f*)",
      "Bash(git tag --force*)",
      "Bash(git tag * --force*)",
      "Bash(git tag -af*)",
      "Bash(git tag * -af*)",
      "Bash(git tag -sf*)",
      "Bash(git tag * -sf*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f*)",
      "Bash(git branch --force*)",
      "Bash(git branch * --force*)",
      "Bash(git clean *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout * --force*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch --force*)",
      "Bash(git switch * --force*)",
      "Bash(git switch --discard-changes *)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git branch --delete --force *)",
      "Bash(git update-ref *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(supabase login *)",
      "Bash(supabase link *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset --linked *)",
      "Bash(supabase migration repair *)",
      "Bash(supabase migration up --linked *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase secrets set *)",
      "Bash(supabase config push *)",
      "Bash(supabase projects create *)",
      "Bash(supabase projects delete *)",
      "Bash(npx supabase login *)",
      "Bash(npx supabase link *)",
      "Bash(npx supabase db push *)",
      "Bash(npx supabase db reset --linked *)",
      "Bash(npx supabase migration repair *)",
      "Bash(npx supabase migration up --linked *)",
      "Bash(npx supabase functions deploy *)",
      "Bash(npx supabase secrets set *)",
      "Bash(npx supabase config push *)",
      "Bash(npx supabase projects create *)",
      "Bash(npx supabase projects delete *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.sonar)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.sonar)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/pre-edit.sh"],
            "timeout": 10,
            "statusMessage": "Checking the path (pre-edit guard)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/post-edit.sh"],
            "timeout": 30,
            "statusMessage": "Formatting, linting and checking rules for the edited file"
          }
        ]
      }
    ]
  }
}
