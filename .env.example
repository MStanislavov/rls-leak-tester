# RLS Leak Tester: environment variables.
# Every value is optional. With none of them set, `npm run dev` gives a fully working lab.
# Copy this file to .env.local and fill in only what you need. Never commit real values.
# An empty value counts as unset. src/lib/config validates all of them and is the only reader.

# Product name shown in the UI. Defaults to "RLS Leak Tester".
NEXT_PUBLIC_APP_NAME=

# Public origin of the deployed site, such as https://example.com, for metadata and share links.
NEXT_PUBLIC_SITE_URL=

# Anthropic API key for the Explain button. Without it the feature shows a notice instead.
ANTHROPIC_API_KEY=

# Model id override. The default is defined once, in src/lib/ai/model.ts.
ANTHROPIC_MODEL=

# Redis URL (redis:// locally via docker compose, rediss:// when managed). Required for Explain in production.
REDIS_URL=

# Supabase project URL. Together with the anon key it enables sign-in and shared scenarios.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Safe for the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server only. Leave empty unless a server task truly needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1, together with ANTHROPIC_API_KEY, to let the test suite call the real model.
RUN_LIVE_AI_TESTS=

# Not set by hand: NODE_ENV comes from Next.js; VERCEL_ENV and VERCEL_GIT_COMMIT_SHA come from Vercel.
