# RLS Leak Tester: environment variables.
# Every value is optional. With none of them set, `npm run dev` gives a fully working lab.
# Copy this file to .env.local and fill in only what you need. Never commit real values.

# Product name shown in the UI. Defaults to "RLS Leak Tester".
NEXT_PUBLIC_APP_NAME=

# Public origin of the deployed site, for example https://example.com (metadata and share links).
NEXT_PUBLIC_SITE_URL=

# AI explanations (the Explain button). Without a key the feature is hidden behind a notice.
ANTHROPIC_API_KEY=
# Model id override. The default lives in src/lib/ai.
ANTHROPIC_MODEL=

# Redis for rate limiting, the explanation cache and the single-flight lock.
# Local: redis://localhost:6379  Managed: a rediss:// URL.
# In production /api/explain stays disabled without it.
REDIS_URL=

# Supabase for sign-in and shared scenarios. Without these, Share is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Leave empty unless a server task truly needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 together with ANTHROPIC_API_KEY to let the test suite call the real model.
RUN_LIVE_AI_TESTS=
