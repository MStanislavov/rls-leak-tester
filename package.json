{
  "name": "postgres-rls-leak-tester",
  "version": "0.1.0",
  "description": "Test whether your Postgres and Supabase row-level security policies actually isolate users and tenants, in your browser, with a CI-ready proof.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "rules": "node scripts/rules-check.mjs",
    "rules:fast": "node scripts/rules-check.mjs --",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "next build && playwright test",
    "e2e:dev": "E2E_MODE=dev playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sonar": "bash scripts/sonar/scan.sh",
    "sonar:bootstrap": "bash scripts/sonar/bootstrap.sh",
    "quality": "node scripts/quality.mjs",
    "prepare": "node scripts/hooks/install-git-hooks.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "node scripts/rules-check.mjs --"
    ],
    "!(*.{js,jsx,mjs,cjs,ts,tsx,mts,cts})": [
      "prettier --write --ignore-unknown",
      "node scripts/rules-check.mjs --"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/react": "^4.0.130",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.107",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "geist": "^1.7.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sonar/scan": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false,
    "fsevents": false
  },
  "overrides": {
    "@sonar/scan": {
      "adm-zip": "0.6.1"
    }
  }
}
